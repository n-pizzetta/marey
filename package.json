{
  "name": "marey",
  "private": true,
  "version": "0.11.2",
  "description": "Dashboard for Claude Code, Codex and Copilot CLI sessions: plan usage, running sessions and replay",
  "keywords": [
    "claude-code",
    "codex",
    "copilot",
    "anthropic",
    "debugger",
    "replay",
    "analytics",
    "visualization",
    "dashboard",
    "agent"
  ],
  "homepage": "https://github.com/n-pizzetta/marey",
  "repository": {
    "type": "git",
    "url": "https://github.com/n-pizzetta/marey.git"
  },
  "bugs": {
    "url": "https://github.com/n-pizzetta/marey/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Nathan Pizzetta",
    "url": "https://github.com/n-pizzetta"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "marey": "scripts/serve.mjs"
  },
  "files": [
    "dist",
    "!dist/sessions.json",
    "scripts",
    "hooks",
    "commands",
    ".claude-plugin",
    ".codex-plugin",
    "codex-skills",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "parse": "node scripts/parse-sessions.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3"
  }
}
